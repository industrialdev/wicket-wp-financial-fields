msgstr "Date de fin de la période : %1$s → %2$s"

msgctxt "label"
msgid "Finance Mapping"
msgstr "Correspondance financière"

msgid "GL mapping from your financial management system."
msgstr "Correspondance avec le grand livre de votre système de gestion financière."

msgctxt "label"
msgid "Deferred revenue required"
msgstr "Produits reportés requis"

msgid "Select if this product will use a deferred revenue schedule in your financial management system."
msgstr "Indiquez si ce produit utilisera un calendrier de produits reportés dans votre système de gestion financière."

msgctxt "label"
msgid "Deferral Start Date"
msgstr "Date de début du report"

msgctxt "label"
msgid "Deferral End Date"
msgstr "Date de fin du report"

msgid "Deferral End Date is required when Deferral Start Date is set."
msgstr "La date de fin du report est obligatoire lorsque la date de début du report est définie."

msgid "Deferral Start Date is required when Deferral End Date is set."
msgstr "La date de début du report est obligatoire lorsque la date de fin du report est définie."

msgid "Deferral End Date must be the same as or later than Deferral Start Date."
msgstr "La date de fin du report doit être identique ou postérieure à la date de début du report."

msgid "Some finance deferral dates need attention. Start Date and End Date must be entered together, and End Date cannot be earlier than Start Date."
msgstr "Certaines dates de report financières doivent être vérifiées. La date de début et la date de fin doivent être entrées ensemble, et la date de fin ne peut pas être antérieure à la date de début."

#. translators: %s: validation error message.
#, php-format
msgctxt "message"
msgid "Finance: %s"
msgstr "Finances : %s"

#. translators: 1: variation number, 2: validation message
#, php-format
msgctxt "message"
msgid "Variation #%1$d: %2$s"
msgstr "Variation n° %1$d : %2$s"

msgctxt "label"
msgid "Finance"
msgstr "Finances"

msgid "Revenue Deferral Dates — Feature Control"
msgstr "Dates de report des produits : contrôle de la fonction"

msgid "Enable Finance Mapping System"
msgstr "Activer le système de correspondance financière"

msgid "Enable the entire finance mapping and deferral dates system."
msgstr "Active l'ensemble du système de correspondance financière et des dates de report."

msgid "Revenue Deferral Dates — Customer Visibility"
msgstr "Dates de report des produits : visibilité pour les clients"

msgid "Product Categories for Customer Display"
msgstr "Catégories de produits affichées aux clients"

msgid "Select product categories that should display deferral dates to customers. Only products in these categories will show deferral dates on customer-facing surfaces."
msgstr "Sélectionnez les catégories de produits dont les dates de report doivent être affichées aux clients. Seuls les produits de ces catégories afficheront les dates de report dans les pages destinées aux clients."

msgctxt "label"
msgid "Order Confirmation Page"
msgstr "Page de confirmation de commande"

msgid "Display deferral dates on the order confirmation page."
msgstr "Afficher les dates de report sur la page de confirmation de commande."

msgctxt "label"
msgid "Email Notifications"
msgstr "Notifications par courriel"

msgid "Display deferral dates in email notifications (Pending payment, On hold, Processing, Completed, Renewal)."
msgstr "Afficher les dates de report dans les notifications par courriel (En attente de paiement, En attente, En cours, Terminée, Renouvellement)."

msgctxt "label"
msgid "My Account › Orders"
msgstr "Mon compte › Commandes"

msgid "Display deferral dates in the My Account order details view."
msgstr "Afficher les dates de report dans les détails de commande de Mon compte."

msgctxt "label"
msgid "Subscriptions Details"
msgstr "Détails des abonnements"

msgid "Display deferral dates in subscription details (WooCommerce Subscriptions required)."
msgstr "Afficher les dates de report dans les détails des abonnements (WooCommerce Subscriptions requis)."

msgctxt "label"
msgid "PDF Invoices"
msgstr "Factures PDF"

msgid "Display deferral dates in PDF invoices (supported invoice plugin required)."
msgstr "Afficher les dates de report dans les factures PDF (extension de facturation compatible requise)."

msgid "Revenue Deferral Dates — Dynamic Deferral Dates Trigger"
msgstr "Dates de report des produits : déclencheur des dates de report dynamiques"

msgid "Determines the WooCommerce order status that triggers dynamic deferral dates to be written. Regardless of this setting, dates will always be written when the order reaches \"Processing\" status."
msgstr "Détermine l'état de commande WooCommerce qui déclenche l'écriture des dates de report dynamiques. Peu importe ce paramètre, les dates sont toujours écrites lorsque la commande passe à l'état « En cours »."

#. translators: %s: order status name.
#, php-format
msgctxt "label"
msgid "%s (Required)"
msgstr "%s (obligatoire)"

msgid "This option is always enabled and cannot be disabled."
msgstr "Cette option est toujours activée et ne peut pas être désactivée."

msgctxt "order status"
msgid "Draft"
msgstr "Brouillon"

#. translators: %s: order status name.
#, php-format
msgid "Write dynamic deferral dates when order status changes to %s."
msgstr "Écrire les dates de report dynamiques lorsque l'état de la commande passe à %s."

#. translators: %s: Comma-separated list of required plugins
#, php-format
msgid "<strong>Wicket Financial Fields</strong> requires the following plugins to be installed and activated: %s"
msgstr "<strong>Champs financiers Wicket</strong> nécessite l'installation et l'activation des extensions suivantes : %s"

#. translators: %s: required plugin name.
#, php-format
msgid "Wicket Financial Fields requires %s to be installed and activated."
msgstr "Champs financiers Wicket nécessite l'installation et l'activation de %s."

msgid "Wicket Financial Fields requires PHP 8.3 or higher. Please upgrade your PHP version."
msgstr "Champs financiers Wicket nécessite PHP 8.3 ou une version ultérieure. Veuillez mettre à jour votre version de PHP."

msgctxt "label"
msgid "Plugin Activation Error"
msgstr "Erreur d'activation de l'extension"
